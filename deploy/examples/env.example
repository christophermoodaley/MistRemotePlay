# Copy to deploy/.env and edit. Do not commit the real file.
# Public DNS name (or IP) of the server running signaling + TURN.
MIST_PUBLIC_HOST=signal.example.org
# Long random secret shared by coturn and the signaling server:
#   openssl rand -hex 32
MIST_TURN_SECRET=
# Optional: require this token from every device (private servers).
MIST_ACCESS_TOKEN=
